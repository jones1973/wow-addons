<!-- core/shared/files.xml -->
<Ui>
    <!--
        Shared infrastructure, copied from the monorepo shared/core/.
        dependencies.lua defines Addon.registerModule and MUST load before any
        file that registers a module (theme, utils, options, commands, etc.).
        events is pre-initialized by the dependency system. utils is
        self-contained.

        theme.lua registers the theme module and its style strategies; themeConfig
        installs Crafty's brand colors via theme.brand.set at file scope, so it
        loads immediately after theme.lua and its strategies. All theme files
        load before the UI (which consumes theme tokens).
    -->
    <Script file="dependencies.lua"/>

    <Script file="theme\theme.lua"/>
    <Script file="theme\style\stock.lua"/>
    <Script file="theme\style\elvui.lua"/>
    <Script file="theme\themeConfig.lua"/>

    <Script file="media\icons.lua"/>

    <Script file="utils.lua"/>
    <Script file="events.lua"/>
    <Script file="pool.lua"/>
    <Script file="commands.lua"/>
    <Script file="options.lua"/>
    <Script file="svRegistry.lua"/>
    <Script file="errorHandler.lua"/>
</Ui>
